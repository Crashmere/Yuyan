    },
    {
      "method": "GET",
      "path": "/api/templates",
      "description": "模板与内容片段摘要列表"
    },
    {
      "method": "POST",
      "path": "/api/templates",
      "description": "保存独立模板或内容片段"
    },
    {
      "method": "GET",
      "path": "/api/templates/{id}",
      "description": "模板内容、预览与图片尺寸"
    },
    {
      "method": "PATCH",
      "path": "/api/templates/{id}",
      "description": "重命名模板，检测版本冲突"
    },
    {
      "method": "DELETE",
      "path": "/api/templates/{id}",
      "description": "删除模板，检测版本冲突"
    },
    {
      "method": "POST",
      "path": "/api/attachments",
      "description": "上传附件，单个最大 25 MiB，按内容去重且不可覆盖"
    },
    {
      "method": "GET",
      "path": "/attachments/{id}",
      "description": "经设备认证下载附件，支持 HEAD、Range 和指定下载文件名"
    },
    {
      "method": "GET",
      "path": "/api/attachments/{id}/preview",
      "description": "读取附件预览类型、文本或压缩包目录，不解压写入磁盘"
    },
    {
      "method": "GET",
      "path": "/attachments/{id}/content",
      "description": "经设备认证读取可预览的图片、PDF、音视频，支持 HEAD 和 Range；拒绝其他类型直读"
    }
