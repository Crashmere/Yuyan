{
  "id": "yuyan",
  "name": "Yuyan",
  "description": "个人知识库、文档、可编辑画板、图片与附件。",
  "icon": "/portal/static/icons/yuyan.svg",
  "url": "/yuyan/",
  "repo": "https://github.com/Crashmere/Yuyan",
  "root": "/opt/yuyan",
  "port": 18084,
  "user": "yuyan",
  "units": [
    "yuyan.service",
    "yuyan-backup.service",
    "yuyan-backup.timer"
  ],
  "database": "/opt/yuyan/data/yuyan.db",
  "backupKind": "media",
  "resources": [
    {
      "id": "data",
      "name": "业务数据",
      "path": "/opt/yuyan/data",
      "purpose": "数据库（文档、保留 30 天的历史、模板与内容片段）、内容寻址的图片与附件、历史迁移材料；历史每天北京时间 03:00 清理且不保底保留，当前及回收站正文保持；图片与附件失去所有正文、历史、回收站或模板引用后连续一小时由应用自动回收，临时文件不属于恢复数据。 画板包复用 assets，预览保存在包内；回收展开图片依赖，包宽限期内也保护图片，未知或损坏包使当轮回收停止。",
      "kind": "data",
      "browse": true,
      "cleanup": false
    },
    {
      "id": "backups",
      "name": "数据备份",
      "path": "/opt/yuyan/backups",
      "purpose": "每日快照保留 14 份；发布前快照保留最近 5 份及受保护版本对应快照；手工备份不自动清理。",
      "kind": "backups",
      "browse": true,
      "cleanup": true
    },
    {
      "id": "releases",
      "name": "部署版本",
      "path": "/opt/yuyan/releases",
      "purpose": "保留最近 3 次成功发布和当前运行版本；已确认恢复的失败批次在后续成功发布且超过 7 天后清理。",
      "kind": "releases",
      "browse": true,
      "cleanup": true
    },
    {
      "id": "config",
      "name": "运行配置",
      "path": "/opt/yuyan/config",
      "purpose": "环境配置、systemd、Nginx 与资源声明；不直接展示秘密。",
      "kind": "config",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "bin",
      "name": "服务程序",
      "path": "/opt/yuyan/bin",
      "purpose": "当前应用程序及固定维护/发布脚本。",
      "kind": "binaries",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "docs",
      "name": "维护文档",
      "path": "/opt/yuyan/docs",
      "purpose": "架构、API、运维与恢复说明。",
      "kind": "documents",
      "browse": true,
      "cleanup": false
    }
  ],
